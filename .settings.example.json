{
    "youtube_dl_path": "./dl/yt-dlp.exe",
    "ffmpeg_path": "./ffmpeg/bin",
    "js_runtime_path": "deno:./deno/deno.exe",
    "download_dir": [
        "C:/Downloads/youtube-downloads",
        "C:/Downloads/youtube-downloads/mp3"
    ],
    "file_title": "%(title)s.%(ext)s",
    "options":[
        "-f 399+140",
        "--extract-audio --audio-format mp3 --audio-quality 0"
    ],
    "colors": "mp4+1080p:cyan, m4a:magenta, ERROR:red",
    "font_name": "courier",
    "font_size": 12,
    "console_bg": "black",
    "console_fg": "#2bfe72",
    "language": "EN",
    "window_size": ""
}
